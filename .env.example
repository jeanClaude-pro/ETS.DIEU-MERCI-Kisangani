# Copy to .env and fill in. Everything prefixed VITE_ is public: it is
# bundled into the browser code, so never put secrets here.
VITE_API_URL=https://your-api.example.com/api

# Minutes without any action before the session signs out (4 at most;
# a smaller value shortens it, a larger one is ignored)
VITE_IDLE_TIMEOUT_MINUTES=4
